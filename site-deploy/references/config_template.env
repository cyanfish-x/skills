# rclone远程配置名称
# 先执行 rclone config 创建同名 remote，例如 my-site:
RCLONE_REMOTE=my-site

# 文件路径（建议绝对路径；相对路径相对 --cwd / 进程 cwd）
LOCAL_DIR="your/local/dist"
REMOTE_DIR="your/remote/dir"

# rclone同步参数
RCLONE_TRANSFERS=8
RCLONE_CHECKERS=16

# CDN操作授权信息（可选；缺任一项则部署时跳过 CDN）
CDN_SECRET_ID="yourid"
CDN_SECRET_KEY="yourkey"
CDN_FLUSH_PATHS="https://demo.example.com/"
# 可选，默认 ap-chengdu
# CDN_REGION=ap-chengdu
